---
import { ChevronDown, Languages, Moon, Sun} from "lucide-react";

const { t, lang = "es" } = Astro.props;
---
<header
  id="site-header"
  class="fixed left-0 top-0 z-50 w-full border-b border-[var(--border)] transition-all duration-500"
>
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-4 px-5 py-4 md:flex-row md:justify-between md:px-8 md:py-5">

    <!-- Logo -->
    <a href={`/${lang}`} class="flex items-center">
      <!-- Claro -->
      <img
        id="logo-light"
        src="/images/Logo-light.png"
        alt="ATS Logo"
        class="block h-10 w-auto md:h-19"
      />

      <!-- Oscuro -->
      <img
        id="logo-dark"
        src="/images/Logo-dark.png"
        alt="ATS Logo"
        class="hidden h-10 w-auto md:h-18"
      />
    </a>

    <!-- Navegación -->
    <nav class="flex max-w-full flex-wrap items-center justify-center gap-x-5 gap-y-3 px-2 text-center md:flex-nowrap md:gap-8 ">
      <a href={`/${lang}#hero`} class="text-sm font-medium text-[var(--muted)] transition hover:text-[var(--primary)]">
        {t.nav.home}
      </a>

      <a href={`/${lang}/about`} class="text-sm font-medium text-[var(--muted)] transition hover:text-[var(--primary)]">
        {t.nav.about}
      </a>

      <a href={`/${lang}/#services`} class="text-sm font-medium text-[var(--muted)] transition hover:text-[var(--primary)]">
        {t.nav.services}
      </a>

      <a href={`/${lang}/sectores`} class="text-sm font-medium text-[var(--muted)] transition hover:text-[var(--primary)]">
        {t.nav.sectors}
      </a>

      <a href={`/${lang}/contact`} class="text-sm font-medium text-[var(--muted)] transition hover:text-[var(--primary)]">
        {t.nav.contact}
      </a>

    </nav>

    <div class="relative flex items-center justify-center gap-3">

    <!-- Botón -->
    <button id="language-button"class="flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3 py-2 text-xs text-[var(--text)] backdrop-blur-md transition hover:bg-[var(--primary)]/10 md:px-4 md:text-sm">
      <Languages size={16} />

      <span id="current-language">
        {lang === "en" ? "EN" : "ES"}
      </span>

      <ChevronDown size={16} className="transition duration-300" id="language-chevron"/>
    </button>


    <button id="theme-toggle" class="flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--surface)] text-[var(--text)] backdrop-blur-md transition hover:scale-105 md:h-10 md:w-10" aria-label="Cambiar tema" >
      <Sun id="sun-icon" size={18} className="hidden" />
      <Moon id="moon-icon" size={18} />
    </button>


    <!-- Dropdown -->
    <div id="language-menu" class="absolute right-0 top-[calc(100%+12px)] z-50 hidden min-w-[180px] overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] shadow-[var(--shadow-soft)] backdrop-blur-2xl">

      <button data-lang="es" class="flex w-full items-center justify-between px-5 py-3 text-sm text-[var(--muted)] transition hover:bg-[var(--primary)]/10 hover:text-[var(--text)]">
        Español
        <span class="text-[var(--primary)]"> ES </span>
      </button>

      <button data-lang="en" class="flex w-full items-center justify-between px-5 py-3 text-sm text-[var(--muted)] transition hover:bg-[var(--primary)]/10 hover:text-[var(--text)]">
        English
        <span class="text-[var(--primary)]"> EN </span>
      </button>

    </div>

</div>

  </div>
</header>

<script>
  const languageButton = document.getElementById("language-button");
  const languageMenu = document.getElementById("language-menu");
  const languageChevron = document.getElementById("language-chevron");
  const header = document.getElementById("site-header");
  const isImageHeroPage  = window.location.pathname.includes("/about") ||
  window.location.pathname.includes("/sectores");;
  const themeToggle = document.getElementById("theme-toggle");
  const sunIcon = document.getElementById("sun-icon");
  const moonIcon = document.getElementById("moon-icon");
  const logoLight = document.getElementById("logo-light") as HTMLImageElement | null;
  const logoDark = document.getElementById("logo-dark") as HTMLImageElement | null;

  const applyTheme = (theme: string) => {
    const isDark = theme === "dark";

    document.documentElement.classList.toggle("dark", isDark);

    sunIcon?.classList.toggle("hidden", isDark);
    moonIcon?.classList.toggle("hidden", !isDark);

    if (logoLight && logoDark) {
      logoLight.style.display = isDark ? "none" : "block";
      logoDark.style.display = isDark ? "block" : "none";
    }
  };

  const savedTheme = localStorage.getItem("theme") || "dark";

  applyTheme(savedTheme);

  themeToggle?.addEventListener("click", () => {
    const isCurrentlyDark = document.documentElement.classList.contains("dark");
    const nextTheme = isCurrentlyDark ? "light" : "dark";

    localStorage.setItem("theme", nextTheme);
    applyTheme(nextTheme);
  });

  languageButton?.addEventListener("click", () => {

    languageMenu?.classList.toggle("hidden");

    languageChevron?.classList.toggle("rotate-180");

  });

  document.querySelectorAll("[data-lang]").forEach((button) => {
    button.addEventListener("click", (e) => {

      const target = e.currentTarget;

      if (!(target instanceof HTMLElement)) return;

      const selectedLang = target.dataset.lang;

      if (!selectedLang) return;

      const path = window.location.pathname;

      // quitar /es o /en del inicio
      const cleanPath = path.replace(/^\/(es|en)/, "");

      // nueva ruta
      window.location.href = `/${selectedLang}${cleanPath}`;

    });
  });

  window.addEventListener("click", (e) => {

    const target = e.target;

    if (!(target instanceof Node)) return;

    if (
      !languageButton?.contains(target) &&
      !languageMenu?.contains(target)
    ) {

      languageMenu?.classList.add("hidden");

      languageChevron?.classList.remove("rotate-180");

    }

  });

  const updateHeader = () => {
  if (!header) return;

  if (window.scrollY > 40 || isImageHeroPage ) {
    header.classList.add(
      "bg-[var(--surface-soft)]",
      "backdrop-blur-xl",
      "shadow-[var(--shadow-soft)]"
    );
  } else {
    header.classList.remove(
      "bg-[var(--surface-soft)]",
      "backdrop-blur-xl",
      "shadow-[var(--shadow-soft)]"
    );
    }
  };

  updateHeader();

  window.addEventListener("scroll", updateHeader);
  window.addEventListener("load", updateHeader);
</script>