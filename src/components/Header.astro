<header
  id="site-header"
  class="fixed left-0 top-0 z-50 w-full border-b border-white/5 transition-all duration-500"
>
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-4 px-5 py-4 md:flex-row md:justify-between md:px-8 md:py-5">

    <!-- Logo -->
    <a href="/" class="flex items-center">
      <img
        src="/images/Logo.png"
        alt="ATS Logo"
        class="h-9 w-auto md:h-12"
      />
    </a>

    <!-- Navegación -->
    <nav class="flex max-w-full items-center gap-4 overflow-x-auto whitespace-nowrap px-2 text-center [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:gap-8">
      <a href="/#hero" class="text-sm font-medium text-white/80 transition hover:text-[#12b5ea]">
        Inicio
      </a>

      <a href="/about" class="text-sm font-medium text-white/80 transition hover:text-[#12b5ea]">
        Sobre nosotros
      </a>

      <a href="/#services" class="text-sm font-medium text-white/80 transition hover:text-[#12b5ea]">
        Servicios
      </a>

      <a href="/sectores" class="text-sm font-medium text-white/80 transition hover:text-[#12b5ea]">
        Sectores
      </a>

      <a href="/#information" class="text-sm font-medium text-white/80 transition hover:text-[#12b5ea]">
        Contacto
      </a>

    </nav>

    <!-- Idioma -->
    <select
      class="hidden rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm text-white backdrop-blur-md outline-none md:block"
    >
      <option class="text-black">Español</option>
      <option class="text-black">English</option>
    </select>

  </div>
</header>

<script>
  const header = document.getElementById("site-header");

  const updateHeader = () => {
    if (!header) return;

    if (window.scrollY > 40) {
      header.classList.add(
        "bg-[#0b0b0c]/80",
        "backdrop-blur-xl",
        "shadow-[0_10px_40px_rgba(0,0,0,0.35)]"
      );
    } else {
      header.classList.remove(
        "bg-[#0b0b0c]/80",
        "backdrop-blur-xl",
        "shadow-[0_10px_40px_rgba(0,0,0,0.35)]"
      );
    }
  };

  updateHeader();

  window.addEventListener("scroll", updateHeader);
  window.addEventListener("load", updateHeader);
</script>