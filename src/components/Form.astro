---
import { ArrowLeft, Send, Mail } from "lucide-react";

const { t, lang = "es" } = Astro.props;
---

<section class="relative min-h-screen overflow-hidden bg-[var(--bg)] px-5 py-10 pt-50 text-[var(--text)] transition-colors duration-500 md:pt-32">
  <div class="pointer-events-none absolute right-[-180px] top-[-180px] h-[420px] w-[420px] rounded-full bg-[var(--primary)]/10 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-[-180px] left-[-180px] h-[420px] w-[420px] rounded-full bg-[var(--primary)]/10 blur-3xl"></div>

  <div class="relative z-10 mx-auto flex min-h-[85vh] max-w-6xl items-center justify-center">
    <div class="grid w-full gap-10 rounded-[40px] border border-[var(--border)] bg-[var(--surface)] p-6 shadow-[var(--shadow-soft)] backdrop-blur-xl md:grid-cols-[0.9fr_1.1fr] md:p-10">
      
      <div class="flex flex-col justify-between">
        <div>
          <a
            href={`/${lang}`}
            class="relative z-10 mb-5 inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface-soft)] px-5 py-3 text-sm text-[var(--muted)] backdrop-blur-md transition hover:border-[var(--primary)]/40 hover:bg-[var(--primary)]/10 hover:text-[var(--text)]"
          >
            <ArrowLeft size={16} />
            {t.evaluation.back}
          </a>

          <span class="mb-5 inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--primary)]">
            <Mail size={16} />
            {t.evaluation.badge}
          </span>

          <h1 class="mb-6 text-4xl font-bold leading-tight tracking-[-0.04em] text-[var(--text)] md:text-5xl">
            {t.evaluation.title}
          </h1>

          <p class="max-w-md leading-8 text-[var(--muted)]">
            {t.evaluation.description}
          </p>
        </div>
      </div>

      <form class="grid gap-5">
        <div class="grid gap-5 md:grid-cols-2">
          <input class="w-full rounded-2xl border border-[var(--border)] bg-[var(--surface-soft)] px-5 py-4 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[var(--primary)]/50 focus:bg-[var(--surface)]" type="text" placeholder={t.evaluation.form.firstName} required />
          <input class="w-full rounded-2xl border border-[var(--border)] bg-[var(--surface-soft)] px-5 py-4 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[var(--primary)]/50 focus:bg-[var(--surface)]" type="text" placeholder={t.evaluation.form.lastName} required />
        </div>

        <input class="w-full rounded-2xl border border-[var(--border)] bg-[var(--surface-soft)] px-5 py-4 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[var(--primary)]/50 focus:bg-[var(--surface)]" type="email" placeholder={t.evaluation.form.email} required />
        <input class="w-full rounded-2xl border border-[var(--border)] bg-[var(--surface-soft)] px-5 py-4 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[var(--primary)]/50 focus:bg-[var(--surface)]" type="text" placeholder={t.evaluation.form.subject} />
        <input class="w-full rounded-2xl border border-[var(--border)] bg-[var(--surface-soft)] px-5 py-4 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[var(--primary)]/50 focus:bg-[var(--surface)]" type="tel" placeholder={t.evaluation.form.phone} />
        <input class="w-full rounded-2xl border border-[var(--border)] bg-[var(--surface-soft)] px-5 py-4 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[var(--primary)]/50 focus:bg-[var(--surface)]" type="text" placeholder={t.evaluation.form.address} />

        <textarea class="min-h-36 w-full resize-none rounded-2xl border border-[var(--border)] bg-[var(--surface-soft)] px-5 py-4 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[var(--primary)]/50 focus:bg-[var(--surface)]" placeholder={t.evaluation.form.message} required></textarea>

        <button type="submit" class="inline-flex items-center justify-center gap-3 rounded-full bg-[var(--primary)] px-8 py-4 text-sm font-semibold text-white shadow-[0_10px_30px_rgba(0,0,0,0.25),0_0_40px_rgba(18,181,234,0.12)] transition hover:-translate-y-1 hover:bg-[#1b75bb]">
          {t.evaluation.form.submit}
          <Send size={16} />
        </button>
      </form>

    </div>
  </div>
</section>