---
import { CheckCircle2, Globe2, ShieldCheck, Workflow, Users } from "lucide-react";

const { t } = Astro.props;

const reasons = [
  {
    number: "01",
    icon: Globe2,
    title: t.about.reasons[0].title,
    text: t.about.reasons[0].text,
  },
  {
    number: "02",
    icon: Workflow,
    title: t.about.reasons[1].title,
    text: t.about.reasons[1].text,
  },
  {
    number: "03",
    icon: CheckCircle2,
    title: t.about.reasons[2].title,
    text: t.about.reasons[2].text,
  },
  {
    number: "04",
    icon: ShieldCheck,
    title: t.about.reasons[3].title,
    text: t.about.reasons[3].text,
  },
  {
    number: "05",
    icon: Users,
    title: t.about.reasons[4].title,
    text: t.about.reasons[4].text,
  },
];
---

<section class="relative overflow-hidden bg-[var(--bg)] text-[var(--text)] transition-colors duration-500" id="about">

  <div class="relative h-[460px] overflow-hidden">
    <img src="/images/About.png" alt="Sobre ATS" class="h-full w-full object-cover" />

    <div class="absolute inset-0 bg-black/45"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/40 via-black/20 to-transparent"></div>

    <div class="relative z-10 mx-auto flex h-full max-w-7xl items-center px-5 pt-24 md:px-8">
      <div class="max-w-3xl">
        <span class="mb-5 inline-block rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-sm text-[var(--primary)] backdrop-blur-md">
          {t.about.badge}
        </span>

        <h1 class="mb-6 text-4xl font-bold leading-[0.95] tracking-[-0.05em] text-white md:text-6xl lg:text-7xl">
          {t.about.title}
        </h1>

        <p class="max-w-2xl text-lg leading-8 text-white/70">
          {t.about.description}
        </p>
      </div>
    </div>
  </div>

  <div class="relative px-5 py-28 md:px-8">
    <div class="pointer-events-none absolute left-[-180px] top-20 h-[420px] w-[420px] rounded-full bg-[var(--primary)]/10 blur-3xl"></div>

    <div class="relative mx-auto grid max-w-7xl gap-8 md:grid-cols-2">
      {
        reasons.map((item) => {
          const Icon = item.icon;

          return (
            <article class="group rounded-[32px] border border-[var(--border)] bg-[var(--surface)] p-8 shadow-[var(--shadow-soft)] backdrop-blur-xl transition duration-500 hover:-translate-y-2 hover:border-[var(--primary)]/40">
              <div class="mb-8 flex items-center justify-between">
                <span class="text-sm font-semibold tracking-[0.25em] text-[var(--primary)]">
                  {item.number}
                </span>

                <span class="flex h-14 w-14 items-center justify-center rounded-2xl border border-[var(--border)] bg-[var(--primary)]/10 text-[var(--primary)]">
                  <Icon size={26} strokeWidth={1.8} />
                </span>
              </div>

              <h2 class="mb-4 text-2xl font-semibold text-[var(--text)]">
                {item.title}
              </h2>

              <p class="leading-8 text-[var(--muted)]">
                {item.text}
              </p>
            </article>
          );
        })
      }
    </div>
  </div>

</section>