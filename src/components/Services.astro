---
import {
  Shield,
  Network,
  Server,
  Briefcase,
  MonitorCog,
  ArrowUpRight
} from "lucide-react";

const { t, lang = "es" } = Astro.props;

const services = [
  {
    title: t.services.items[0].title,
    slug: "desarrollo-software",
    description: t.services.items[0].description,
    icon: MonitorCog,
  },
  {
    title: t.services.items[1].title,
    slug: "soporte-infraestructura",
    description: t.services.items[1].description,
    icon: Server,
  },
  {
    title: t.services.items[2].title,
    slug: "redes-empresariales",
    description: t.services.items[2].description,
    icon: Network,
  },
  {
    title: t.services.items[3].title,
    slug: "ciberseguridad",
    description: t.services.items[3].description,
    icon: Shield,
  },
  {
    title: t.services.items[4].title,
    slug: "gestion-proyectos",
    description: t.services.items[4].description,
    icon: Briefcase,
  },
];
---

<section
  id="services"
  class="relative overflow-hidden bg-[#0b0b0c] px-5 md:px-8 py-32"
>

  <div class="mx-auto max-w-7xl">

    <!-- Header -->
    <div class="mb-20 text-center">

      <span class="mb-4 inline-block rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/60 backdrop-blur-md">
        {t.services.badge}
      </span>

      <h2 class="mx-auto mb-6 max-w-3xl text-4xl md:text-6xl lg:text-7xl font-bold leading-tight tracking-[-0.04em] text-white">
        {t.services.title}
      </h2>

      <p class="mx-auto max-w-2xl text-lg leading-8 text-white/60">
        {t.services.description}
      </p>

    </div>

    <!-- Grid -->
    <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">

      {
        services.map((service) => {
          const Icon = service.icon;

          return (
            <article class="group rounded-[32px] border border-white/10 bg-white/[0.03] p-8 backdrop-blur-xl transition duration-500 hover:-translate-y-2 hover:border-[#12b5ea]/40 hover:bg-white/[0.05]" >

              <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-white">
                <Icon size={30} strokeWidth={1.8} />
              </div>

              <h3 class="mb-4 text-2xl font-semibold text-white">
                {service.title}
              </h3>

              <p class="mb-8 leading-7 text-white/60">
                {service.description}
              </p>

              <a href={`/${lang}/services/${service.slug}`} class="inline-flex items-center gap-2 text-sm font-medium text-[#12b5ea] transition hover:text-white" >
                {t.services.readMore}
                <ArrowUpRight
                  size={16}
                />
              </a>

            </article>
          );
        })
      }

    </div>

  </div>

</section>