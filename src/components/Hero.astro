---
import { ArrowRight, Sparkles } from "lucide-react";

const { t, lang = "es" } = Astro.props;
---

<section id="hero" class="relative min-h-screen overflow-hidden bg-[#0b0b0c]">

  <!-- Fondo degradado -->
  <div class="absolute inset-0 bg-gradient-to-r from-black via-[#0b0b0c] to-[#0b0b0c]/80"></div>

  <!-- Grid -->
  <div
    class="absolute inset-0 opacity-[0.04]"
    style="
      background-image:
      linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
      background-size: 60px 60px;
    "
  ></div>

  <!-- Glow centro -->
  <div class="hero-glow absolute left-1/2 top-[20%] h-[320px] w-[320px] -translate-x-1/2 rounded-full bg-[#12b5ea]/10 blur-3xl"></div>

  <!-- Glow pequeño -->
  <div class="hero-glow-delayed absolute left-[15%] bottom-[10%] h-[220px] w-[220px] rounded-full bg-[#12b5ea]/8 blur-3xl"></div>

  <!-- Glow izquierda -->
  <div class="hero-glow absolute left-[-220px] top-[-220px] h-[520px] w-[520px] rounded-full bg-[#12b5ea]/10 blur-3xl"></div>

  <!-- Glow derecha -->
  <div class="hero-glow-delayed absolute bottom-[-220px] right-[-220px] h-[520px] w-[520px] rounded-full bg-[#12b5ea]/10 blur-3xl"></div>

  <!-- Líneas decorativas tipo data flow -->
  <div class="absolute inset-0 overflow-hidden">

    <div class="data-line absolute left-[10%] top-[20%] w-[280px] rotate-[25deg]"></div>

    <div class="data-line data-line-slow absolute bottom-[20%] left-[25%] w-[240px] rotate-[12deg] z-1"></div>

  </div>

  <!-- Partículas -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">

    <span class="particle left-[12%] top-[18%]"></span>

    <span class="particle particle-sm left-[22%] top-[70%]"></span>

    <span class="particle particle-lg left-[55%] top-[30%]"></span>

    <span class="particle particle-delay left-[78%] top-[22%]"></span>

    <span class="particle particle-sm particle-slow left-[82%] top-[68%]"></span>

    <span class="particle particle-lg particle-delay left-[38%] top-[82%]"></span>

  </div>


  <!-- Logo ATS -->
  <div class="pointer-events-none absolute right-[-120px] top-1/2 hidden -translate-y-1/2 lg:block">

    <img
      src="/images/Logo.png"
      alt="ATS Logo"
      class="hero-logo w-[600px] opacity-[0.1] drop-shadow-[0_0_20px_rgba(18,181,234,0.12)]"
    />

  </div>

  <!-- Contenido -->
  <div class="relative z-10 mx-auto flex min-h-screen max-w-7xl items-center px-5 pt-28 sm:px-8">

    <div class="max-w-2xl">

      <!-- Badge -->
      <div class="hero-fade mb-6 inline-flex items-center gap-2 rounded-full border border-[#12b5ea]/20 bg-[#12b5ea]/10 px-4 py-2 text-sm text-[#8edfff] backdrop-blur-md">
        <Sparkles size={16} />

        <span>{t.hero.badge}</span>
      </div>

      <!-- Título -->
      <h1 class="hero-fade-delay mb-6 text-4xl font-bold leading-tight tracking-[-0.04em] text-white sm:text-5xl md:text-7xl">
        {t.hero.title}
      </h1>

      <!-- Descripción -->
      <p class="hero-fade-delay-2 mb-10 max-w-xl text-lg leading-8 text-white/60">
        {t.hero.description}
      </p>

      <!-- Botones -->
      <div class="hero-fade-delay-3 flex flex-wrap gap-4">

        <!-- Principal -->
        <a
          href={`/${lang}/about`}
          class="inline-flex items-center gap-3 rounded-full bg-[#12b5ea] px-8 py-4 text-sm font-semibold text-white shadow-[0_10px_30px_rgba(0,0,0,0.35),0_0_40px_rgba(18,181,234,0.12)] transition duration-300 hover:-translate-y-1 hover:bg-[#1b75bb]"
        >
          {t.hero.primaryButton}

          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10">
            <ArrowRight size={16} />
          </span>
        </a>

        <!-- Secundario -->
        <a
          href={`/${lang}/#services`}
          class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-8 py-4 text-sm font-medium text-white backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-[#12b5ea]/30 hover:bg-[#12b5ea]/10"
        >
          {t.hero.secondaryButton}
        </a>

      </div>

    </div>

  </div>

</section>

<style>

  /* Fade */

  .hero-fade,
  .hero-fade-delay,
  .hero-fade-delay-2,
  .hero-fade-delay-3 {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFade 1s ease forwards;
  }

  .hero-fade-delay {
    animation-delay: 0.15s;
  }

  .hero-fade-delay-2 {
    animation-delay: 0.3s;
  }

  .hero-fade-delay-3 {
    animation-delay: 0.45s;
  }

  @keyframes heroFade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Glows */

  .hero-glow {
    animation: glowMove 12s ease-in-out infinite alternate;
  }

  .hero-glow-delayed {
    animation: glowMove 16s ease-in-out infinite alternate-reverse;
  }

  @keyframes glowMove {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }

    to {
      transform: translate3d(40px, 30px, 0) scale(1.08);
    }
  }

  /* Logo */

  .hero-logo {
    animation: logoFloat 8s ease-in-out infinite;
  }

  @keyframes logoFloat {
    0% {
      transform: translateY(0px);
    }

    50% {
      transform: translateY(-18px);
    }

    100% {
      transform: translateY(0px);
    }
  }

  /* Líneas */

  /* Líneas tipo data flow */

  .data-line {
    position: absolute;
    height: 1px;
    overflow: hidden;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(18, 181, 234, 0.16),
      transparent
    );
    opacity: 0.75;
  }

  .data-line::before {
    content: "";
    position: absolute;
    inset: 0;
    width: 35%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(142, 223, 255, 0.95),
      transparent
    );
    filter: drop-shadow(0 0 8px rgba(18, 181, 234, 0.8));
    animation: dataFlow 3.8s ease-in-out infinite;
  }

  .data-line-delay::before {
    animation-delay: 1.4s;
  }

  .data-line-slow::before {
    animation-duration: 5.2s;
  }

  @keyframes dataFlow {
    0% {
      transform: translateX(-130%);
      opacity: 0;
    }

    15% {
      opacity: 1;
    }

    75% {
      opacity: 1;
    }

    100% {
      transform: translateX(330%);
      opacity: 0;
    }
  }

  /* Partículas */

.particle {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 999px;

  background: rgba(211, 216, 218, 0.22);

  box-shadow:
    0 0 12px rgba(181, 210, 219, 0.35),
    0 0 30px rgba(137, 147, 150, 0.15);

  backdrop-filter: blur(4px);

  animation: floatParticle 12s ease-in-out infinite;
}

.particle-sm {
  width: 6px;
  height: 6px;
  opacity: 0.5;
}

.particle-lg {
  width: 16px;
  height: 16px;
  opacity: 0.8;
}

.particle-delay {
  animation-delay: 3s;
}

.particle-slow {
  animation-duration: 18s;
}

@keyframes floatParticle {

  0% {
    transform: translate3d(0, 0, 0);
  }

  25% {
    transform: translate3d(12px, -18px, 0);
  }

  50% {
    transform: translate3d(-8px, -30px, 0);
  }

  75% {
    transform: translate3d(18px, -12px, 0);
  }

  100% {
    transform: translate3d(0, 0, 0);
  }

  }
</style>