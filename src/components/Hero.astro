---
import { ArrowRight, Sparkles } from "lucide-react";

const { t, lang = "es" } = Astro.props;
---

<section id="hero" class="relative min-h-screen overflow-hidden bg-[#0b0b0c]">

  <!-- Fondo -->
  <div class="absolute inset-0 bg-gradient-to-r from-black via-[#0b0b0c] to-[#0b0b0c]/80"></div>

  <!-- Glow -->
  <div class="absolute left-[-200px] top-[-200px] h-[500px] w-[500px] rounded-full bg-[#12b5ea]/10 blur-3xl"></div>

  <!-- Mundo ATS -->
  <img src="/images/Logo.png" alt="ATS Globe" class="pointer-events-none absolute right-[80px] top-1/2 hidden w-[520px] -translate-y-1/2 opacity-20 drop-shadow-[0_0_40px_rgba(18,181,234,0.10)] lg:block"/>

  <!-- Grid decorativo -->
  <div class="absolute inset-0 opacity-[0.03]"
    style="
      background-image:
      linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
      background-size: 60px 60px;
    "></div>

  <!-- Contenido -->
  <div class="relative z-10 mx-auto flex min-h-screen max-w-7xl items-center px-5 pt-28 sm:px-8">

    <div class="max-w-2xl">

      <!-- Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#12b5ea]/20 bg-[#12b5ea]/10 px-4 py-2 text-sm text-[#8edfff] backdrop-blur-md">
        <Sparkles size={16} />
        <span> { t.hero.badge } </span>
      </div>

      <!-- Título -->
      <h1 class="mb-6 text-4xl font-bold leading-tight tracking-[-0.04em] text-white sm:text-5xl md:text-7xl">
        {t.hero.title}
      </h1>

      <!-- Descripción -->
      <p class="mb-10 max-w-xl text-lg leading-8 text-white/60">
        {t.hero.description}
      </p>

      <!-- Botones -->
      <div class="flex flex-wrap gap-4">

        <!-- Principal -->
        <a href={`/about?lang=${lang}`} class="inline-flex items-center gap-3 rounded-full bg-[#12b5ea] px-8 py-4 text-sm font-semibold text-white shadow-[0_10px_30px_rgba(0,0,0,0.35),0_0_40px_rgba(18,181,234,0.12)] transition duration-300 hover:-translate-y-1 hover:bg-[#1b75bb]">
          {t.hero.primaryButton}

          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10">
            <ArrowRight size={16} />
          </span>
        </a>

        <!-- Secundario -->
        <a href={`/?lang=${lang}#services`} class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-8 py-4 text-sm font-medium text-white backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-[#12b5ea]/30 hover:bg-[#12b5ea]/10">
          {t.hero.secondaryButton}
        </a>

      </div>

    </div>

  </div>

</section>