---
import { ArrowRight, Sparkles } from "lucide-react";

const { t, lang = "es" } = Astro.props;
---

<section id="hero" class="relative min-h-screen overflow-hidden bg-[var(--bg)] text-[var(--text)] transition-colors duration-500">

  <!-- Fondo degradado -->
  <div class="hero-bg absolute inset-0"></div>

  <!-- Grid -->
  <div class="hero-grid absolute inset-0"></div>

  <!-- Glow centro -->
  <div class="hero-glow absolute left-1/2 top-[20%] h-[320px] w-[320px] -translate-x-1/2 rounded-full bg-[var(--primary)]/10 blur-3xl"></div>

  <!-- Glow pequeño -->
  <div class="hero-glow-delayed absolute left-[15%] bottom-[10%] h-[220px] w-[220px] rounded-full bg-[var(--primary)]/10 blur-3xl"></div>

  <!-- Glow izquierda -->
  <div class="hero-glow absolute left-[-220px] top-[-220px] h-[520px] w-[520px] rounded-full bg-[var(--primary)]/10 blur-3xl"></div>

  <!-- Glow derecha -->
  <div class="hero-glow-delayed absolute bottom-[-220px] right-[-220px] h-[520px] w-[520px] rounded-full bg-[var(--primary)]/10 blur-3xl"></div>

  <!-- Líneas decorativas tipo data flow -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="data-line absolute left-[10%] top-[20%] w-[280px] rotate-[25deg]"></div>
    <div class="data-line data-line-slow absolute bottom-[20%] left-[25%] z-[1] w-[240px] rotate-[12deg]"></div>
  </div>

  <!-- Partículas -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <span class="particle left-[12%] top-[18%]"></span>
    <span class="particle particle-sm left-[22%] top-[70%]"></span>
    <span class="particle particle-lg left-[55%] top-[30%]"></span>
    <span class="particle particle-delay left-[78%] top-[22%]"></span>
    <span class="particle particle-sm particle-slow left-[82%] top-[68%]"></span>
    <span class="particle particle-lg particle-delay left-[38%] top-[82%]"></span>
  </div>

  <!-- Logo ATS -->
  <div class="pointer-events-none absolute left-1/2 top-[58%] block -translate-x-1/2 -translate-y-1/2 opacity-60 sm:left-[18%] sm:top-1/2 sm:opacity-100 lg:left-[10%]">
    <img
      src="/images/Logo.png"
      alt="ATS Logo"
      class="hero-logo w-[260px] opacity-[0.06] drop-shadow-[0_0_20px_rgba(18,181,234,0.12)] sm:w-[380px] sm:opacity-[0.08] lg:w-[600px] lg:opacity-[0.1]"
    />
  </div>

  <!-- Tech icons flotantes -->
  <div class="tech-orbit pointer-events-none absolute inset-0 z-[2] block">

    <div class="tech-chip left-[68%] top-[18%] sm:left-[80%] sm:top-[28%]">
      <span>APEX</span>
    </div>

    <div class="tech-chip tech-delay-1 left-[12%] top-[72%] sm:left-[72%] sm:top-[22%]">
      <span>SQL</span>
    </div>

    <div class="tech-chip tech-delay-2 left-[48%] top-[82%] sm:left-[58%] sm:top-[72%]">
      <span>SQL Developer</span>
    </div>

    <div class="tech-chip tech-delay-3 left-[62%] top-[65%] sm:left-[70%] sm:top-[76%]">
      <span>Oracle</span>
    </div>

  </div>

  <!-- Contenido -->
  <div class="relative z-10 mx-auto flex min-h-screen max-w-7xl items-center px-5 pt-50 sm:px-8 sm:pt-36 md:pt-28">

    <div class="max-w-2xl">

      <!-- Badge -->
      <div class="hero-fade mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-sm text-[var(--primary)] shadow-[var(--shadow-soft)] backdrop-blur-md">
        <Sparkles size={16} />
        <span>{t.hero.badge}</span>
      </div>

      <!-- Título -->
      <h1 class="hero-fade-delay mb-6 text-4xl font-bold leading-tight tracking-[-0.04em] text-[var(--text)] sm:text-5xl md:text-7xl">
        {t.hero.title}
      </h1>

      <!-- Descripción -->
      <p class="hero-fade-delay-2 mb-10 max-w-xl text-lg leading-8 text-[var(--muted)]">
        {t.hero.description}
      </p>

      <!-- Botones -->
      <div class="hero-fade-delay-3 flex flex-wrap gap-4">

        <!-- Principal -->
        <a
          href={`/${lang}/about`}
          class="inline-flex items-center gap-3 rounded-full bg-[var(--primary)] px-8 py-4 text-sm font-semibold text-white shadow-[0_10px_30px_rgba(0,0,0,0.25),0_0_40px_rgba(18,181,234,0.12)] transition duration-300 hover:-translate-y-1 hover:bg-[#1b75bb]"
        >
          {t.hero.primaryButton}

          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10">
            <ArrowRight size={16} />
          </span>
        </a>

        <!-- Secundario -->
        <a
          href={`/${lang}/#services`}
          class="inline-flex items-center gap-3 rounded-full border border-[var(--border)] bg-[var(--surface)] px-8 py-4 text-sm font-medium text-[var(--text)] backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-[var(--primary)]/30 hover:bg-[var(--primary)]/10"
        >
          {t.hero.secondaryButton}
        </a>

      </div>

    </div>

  </div>

</section>

<style>
  .hero-bg {
    background:
      radial-gradient(circle at 20% 20%, rgba(18, 181, 234, 0.08), transparent 30%),
      linear-gradient(120deg, #ece7dc, #f4efe6 45%, #e5dfd3);
  }

  html.dark .hero-bg {
    background:
      radial-gradient(circle at 20% 20%, rgba(18, 181, 234, 0.12), transparent 30%),
      linear-gradient(90deg, #000000, #0b0b0c 45%, rgba(11, 11, 12, 0.8));
  }

  .hero-grid {
    opacity: 0.12;
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.18) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  html.dark .hero-grid {
    opacity: 0.04;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.5) 1px, transparent 1px);
  }

  .hero-fade,
  .hero-fade-delay,
  .hero-fade-delay-2,
  .hero-fade-delay-3 {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFade 1s ease forwards;
  }

  .hero-fade-delay {
    animation-delay: 0.15s;
  }

  .hero-fade-delay-2 {
    animation-delay: 0.3s;
  }

  .hero-fade-delay-3 {
    animation-delay: 0.45s;
  }

  @keyframes heroFade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-glow {
    animation: glowMove 12s ease-in-out infinite alternate;
  }

  .hero-glow-delayed {
    animation: glowMove 16s ease-in-out infinite alternate-reverse;
  }

  @keyframes glowMove {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }

    to {
      transform: translate3d(40px, 30px, 0) scale(1.08);
    }
  }

  .hero-logo {
    animation: logoFloat 8s ease-in-out infinite;
  }

  @keyframes logoFloat {
    0%, 100% {
      transform: translateY(0px);
    }

    50% {
      transform: translateY(-18px);
    }
  }

  .data-line {
    position: absolute;
    height: 1px;
    overflow: hidden;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(18, 181, 234, 0.25),
      transparent
    );
    opacity: 0.65;
  }

  html.dark .data-line {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(18, 181, 234, 0.16),
      transparent
    );
    opacity: 0.75;
  }

  .data-line::before {
    content: "";
    position: absolute;
    inset: 0;
    width: 35%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(18, 181, 234, 0.85),
      transparent
    );
    filter: drop-shadow(0 0 8px rgba(18, 181, 234, 0.55));
    animation: dataFlow 3.8s ease-in-out infinite;
  }

  html.dark .data-line::before {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(142, 223, 255, 0.95),
      transparent
    );
    filter: drop-shadow(0 0 8px rgba(18, 181, 234, 0.8));
  }

  .data-line-slow::before {
    animation-duration: 5.2s;
  }

  @keyframes dataFlow {
    0% {
      transform: translateX(-130%);
      opacity: 0;
    }

    15%, 75% {
      opacity: 1;
    }

    100% {
      transform: translateX(330%);
      opacity: 0;
    }
  }

  .particle {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: rgba(18, 181, 234, 0.16);
    box-shadow:
      0 0 12px rgba(18, 181, 234, 0.22),
      0 0 30px rgba(18, 181, 234, 0.1);
    backdrop-filter: blur(4px);
    animation: floatParticle 12s ease-in-out infinite;
  }

  html.dark .particle {
    background: rgba(211, 216, 218, 0.22);
    box-shadow:
      0 0 12px rgba(181, 210, 219, 0.35),
      0 0 30px rgba(137, 147, 150, 0.15);
  }

  .particle-sm {
    width: 6px;
    height: 6px;
    opacity: 0.5;
  }

  .particle-lg {
    width: 16px;
    height: 16px;
    opacity: 0.8;
  }

  .particle-delay {
    animation-delay: 3s;
  }

  .particle-slow {
    animation-duration: 18s;
  }

  @keyframes floatParticle {
    0%, 100% {
      transform: translate3d(0, 0, 0);
    }

    25% {
      transform: translate3d(12px, -18px, 0);
    }

    50% {
      transform: translate3d(-8px, -30px, 0);
    }

    75% {
      transform: translate3d(18px, -12px, 0);
    }
  }

  .tech-chip {
    position: absolute;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: rgba(244, 239, 230, 0.72);
    color: rgba(22, 22, 22, 0.68);
    font-size: 13px;
    font-weight: 600;
    backdrop-filter: blur(14px);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.08),
      inset 0 0 20px rgba(255, 255, 255, 0.45);
    opacity: 0;
    animation: techFloat 9s ease-in-out infinite;
  }

  html.dark .tech-chip {
    border: 1px solid rgba(18, 181, 234, 0.22);
    background: rgba(18, 181, 234, 0.08);
    color: rgba(220, 247, 255, 0.75);
    box-shadow:
      0 0 30px rgba(18, 181, 234, 0.08),
      inset 0 0 20px rgba(255, 255, 255, 0.03);
  }

  .tech-delay-1 {
    animation-delay: 2s;
  }

  .tech-delay-2 {
    animation-delay: 4s;
  }

  .tech-delay-3 {
    animation-delay: 6s;
  }

  @keyframes techFloat {
    0% {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }

    20% {
      opacity: 0.65;
    }

    50% {
      opacity: 0.85;
      transform: translateY(-12px) scale(1);
    }

    80% {
      opacity: 0.45;
    }

    100% {
      opacity: 0;
      transform: translateY(-34px) scale(0.96);
    }
  }

  @media (max-width: 640px) {
    .tech-chip {
      padding: 7px 11px;
      font-size: 11px;
    }

    .data-line {
      width: 160px !important;
      opacity: 0.45;
    }

    .particle-lg {
      width: 10px;
      height: 10px;
    }

    .particle {
      opacity: 0.45;
    }

    .hero-logo {
      filter: blur(0.2px);
    }
  }
</style>