---
import {
  Truck,
  Store,
  Landmark,
  Boxes,
  ArrowUpRight
} from "lucide-react";

const { t } = Astro.props;

const sectors = [
  {
    title: t.sectors.items[0].title,
    icon: Boxes,
    description:
      t.sectors.items[0].description,
  },
  {
    title: t.sectors.items[1].title,
    icon: Landmark,
    description:
      t.sectors.items[1].description,
  },
  {
    title: t.sectors.items[2].title,
    icon: Store,
    description:
      t.sectors.items[2].description,
  },
  {
    title: t.sectors.items[3].title,
    icon: Truck,
    description:
      t.sectors.items[3].description,
  },
];
---

<section class="relative overflow-hidden bg-[#0b0b0c]">

  <!-- Hero -->
  <div class="relative h-[420px] overflow-hidden">

    <img
      src="/images/sectores.jpg"
      alt="Sectores ATS"
      class="h-full w-full object-cover"
    />

    <div class="absolute inset-0 bg-black/60"></div>

    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/70 to-transparent"></div>

    <div class="relative z-10 mx-auto flex h-full max-w-7xl items-center px-5 md:px-8">
      <div class="max-w-2xl">

        <span class="mb-5 inline-block rounded-full border border-[#12b5ea]/20 bg-[#12b5ea]/10 px-4 py-2 text-sm text-[#8edfff]" >
          {t.sectors.badge}
        </span>

        <h1 class="mb-6 text-4xl md:text-6xl lg:text-7xl font-bold leading-[0.95] tracking-[-0.05em] text-white">
          {t.sectors.title}
        </h1>

        <p class="max-w-xl text-lg leading-8 text-white/65">
          {t.sectors.description}
        </p>

      </div>
    </div>
  </div>

  <!-- Sectores -->
  <div class="relative px-5 md:px-8 py-28">

    <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-2">

      {
        sectors.map((sector) => {
          const Icon = sector.icon;

          return (
            <article class="group rounded-[32px] border border-white/10 bg-white/[0.03] p-10 backdrop-blur-xl transition duration-500 hover:-translate-y-2 hover:border-[#12b5ea]/ hover:shadow-[0_0_50px_rgba(18,181,234,0.12)]">

              <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/10 bg-[#12b5ea]/10 text-[#12b5ea]">
                <Icon size={30} strokeWidth={1.8} />
              </div>

              <h2 class="mb-5 text-3xl font-semibold text-white">
                {sector.title}
              </h2>

              <p class="leading-8 text-white/60 [&_strong]:font-semibold [&_strong]:text-white"
                set:html={sector.description}
              />
            </article>
          );
        })
      }

    </div>

  </div>

</section>