---
import { ChevronLeft, ChevronRight } from "lucide-react";

const { t } = Astro.props;

const history = [
  {
    year: t.history.items[0].year,
    title: t.history.items[0].title,
    description: t.history.items[0].description,
  },
  {
    year: t.history.items[1].year,
    title: t.history.items[1].title,
    description: t.history.items[1].description,
  },
  {
    year: t.history.items[2].year,
    title: t.history.items[2].title,
    description: t.history.items[2].description,
  },
  {
    year: t.history.items[3].year,
    title: t.history.items[3].title,
    description: t.history.items[3].description,
  },
  {
    year: t.history.items[4].year,
    title: t.history.items[4].title,
    description: t.history.items[4].description,
  }
];
---
<section class="relative overflow-hidden bg-[#08090b] px-4 py-24 md:px-8 md:py-32" id="history">
  <div class="absolute left-1/2 top-0 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-[#12b5ea]/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl">
    <div class="mb-16 text-center">
      <span class="mb-4 inline-block rounded-full border border-[#12b5ea]/20 bg-[#12b5ea]/10 px-4 py-2 text-sm text-[#8edfff]">
        {t.history.badge}
      </span>

      <h2 class="mx-auto max-w-3xl text-4xl font-bold tracking-[-0.04em] text-white sm:text-5xl md:text-6xl lg:text-7xl">
        {t.history.title}
      </h2>
    </div>

    <div class="relative">
      <button
        id="history-prev"
        class="hidden md:flex absolute -left-5 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-white/10 text-white backdrop-blur-xl transition hover:bg-[#12b5ea]"
      >
        <ChevronLeft size={22} />
      </button>

      <div
        id="history-slider"
        class="flex snap-x snap-mandatory gap-8 overflow-x-auto scroll-smooth pb-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          history.map((item) => (
            <article class="min-w-[85vw] snap-start rounded-[28px] border border-white/10 bg-white/[0.03] p-6 backdrop-blur-xl transition duration-500 hover:-translate-y-2 hover:border-[#12b5ea]/40 hover:shadow-[0_0_50px_rgba(18,181,234,0.12)] sm:min-w-[360px] md:min-w-[430px] md:p-8">
              <span class="mb-4 inline-block text-sm font-semibold tracking-[0.2em] text-[#12b5ea]">
                {item.year}
              </span>

              <h3 class="mb-5 text-2xl font-semibold text-white">
                {item.title}
              </h3>

              <p class="leading-8 text-white/60">
                {item.description}
              </p>
            </article>
          ))
        }
      </div>

      <button
        id="history-next"
        class="hidden md:flex absolute -right-5 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-white/10 text-white backdrop-blur-xl transition hover:bg-[#12b5ea]"
      >
        <ChevronRight size={22} />
      </button>
    </div>
  </div>
</section>

<script>
  const slider = document.getElementById("history-slider");
  const prev = document.getElementById("history-prev");
  const next = document.getElementById("history-next");

  prev?.addEventListener("click", () => {
    slider?.scrollBy({ left: -460, behavior: "smooth" });
  });

  next?.addEventListener("click", () => {
    slider?.scrollBy({ left: 460, behavior: "smooth" });
  });
</script>