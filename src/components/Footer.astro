---
import { Mail, Phone, MapPin, ArrowUpRight } from "lucide-react";

const { t, lang = "es" } = Astro.props;
---

<footer class="relative overflow-hidden bg-[var(--bg)] px-5 py-20 text-[var(--text)] transition-colors duration-500 md:px-8">

  <!-- Glow -->
  <div class="pointer-events-none absolute bottom-[-180px] left-1/2 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-[var(--primary)]/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl">

    <!-- Top -->
    <div class="grid gap-14 border-b border-[var(--border)] pb-14 md:grid-cols-[1.4fr_1fr_1fr]">

      <!-- Brand -->
      <div class="flex flex-col items-center text-center md:items-start md:text-left">

        <img
          src="/images/Logo.png"
          alt="ATS Logo"
          class="mb-6 h-14 w-auto"
        />

        <p class="max-w-sm leading-7 text-[var(--muted)]">
          {t.footer.description}
        </p>

      </div>

      <!-- Navigation -->
      <div class="text-center md:text-left">

        <h3 class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--text)]/80">
          {t.footer.navigationTitle}
        </h3>

        <div class="flex flex-col gap-3">

          <a href={`/${lang}#hero`} class="text-[var(--muted)] transition hover:text-[var(--primary)]">
            {t.footer.navigation.home}
          </a>

          <a href={`/${lang}/about`} class="text-[var(--muted)] transition hover:text-[var(--primary)]">
            {t.footer.navigation.about}
          </a>

          <a href={`/${lang}#services`} class="text-[var(--muted)] transition hover:text-[var(--primary)]">
            {t.footer.navigation.services}
          </a>

          <a href={`/${lang}/sectores`} class="text-[var(--muted)] transition hover:text-[var(--primary)]">
            {t.footer.navigation.sectors}
          </a>

          <a href={`/${lang}#information`} class="text-[var(--muted)] transition hover:text-[var(--primary)]">
            {t.footer.navigation.contact}
          </a>

        </div>

      </div>

      <!-- Contact -->
      <div class="text-center md:text-left">

        <h3 class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--text)]/80">
          {t.footer.contactTitle}
        </h3>

        <div class="space-y-4">

          <a href="tel:+50624375750" class="flex items-center justify-center gap-3 text-[var(--muted)] transition hover:text-[var(--primary)] md:justify-start">
            <Phone size={18} />
            +506 2437 5750
          </a>

          <a href="tel:+50670717800" class="flex items-center justify-center gap-3 text-[var(--muted)] transition hover:text-[var(--primary)] md:justify-start">
            <Phone size={18} />
            +506 7071 7800
          </a>

          <a href="mailto:sales@angular-tech.com" class="flex items-center justify-center gap-3 text-[var(--muted)] transition hover:text-[var(--primary)] md:justify-start">
            <Mail size={18} />
            sales@angular-tech.com
          </a>

          <p class="flex items-center justify-center gap-3 text-[var(--muted)] md:justify-start">
            <MapPin size={18} />
            {t.footer.location}
          </p>

        </div>

      </div>

    </div>

    <!-- Bottom -->
    <div class="flex flex-col items-center justify-between gap-6 pt-8 md:flex-row">

      <p class="text-center text-sm text-[var(--muted)] md:text-left">
        {t.footer.copyright}
      </p>

      <a
        id="back-to-top"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-5 py-3 text-sm text-[var(--text)] transition hover:border-[var(--primary)]/40 hover:bg-[var(--primary)]/10"
      >
        {t.footer.backToTop}

        <ArrowUpRight size={16} />

      </a>

    </div>

  </div>

</footer>
<script>
  const backToTop = document.getElementById("back-to-top");

  backToTop?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  });
</script>