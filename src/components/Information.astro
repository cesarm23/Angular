---
import { ArrowRight, Mail, Phone, MessageCircle } from "lucide-react";

const { t, lang = "es" } = Astro.props;
---

<section
  id="information"
  class="relative overflow-hidden bg-[var(--bg)] px-5 py-28 text-[var(--text)] transition-colors duration-500 md:px-8"
>
  <div class="pointer-events-none absolute right-[-180px] top-[-180px] h-[420px] w-[420px] rounded-full bg-[var(--primary)]/10 blur-3xl"></div>

  <div
    class="relative mx-auto grid max-w-7xl gap-10 rounded-[40px] border border-[var(--border)] bg-[var(--surface)] p-8 shadow-[var(--shadow-soft)] backdrop-blur-xl md:grid-cols-2 md:p-14"
  >
    <div>
      <span class="mb-5 inline-block rounded-full border border-[var(--border)] bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--primary)] backdrop-blur-md">
        {t.information.badge}
      </span>

      <h2 class="mb-6 text-4xl font-bold tracking-[-0.04em] text-[var(--text)] md:text-6xl lg:text-7xl">
        {t.information.title}
      </h2>

      <p class="max-w-xl text-lg leading-8 text-[var(--muted)]">
        {t.information.description}
      </p>
    </div>

    <div class="flex flex-col justify-center gap-5">

      <a
        href="tel:+50624375750"
        class="group flex items-center justify-between rounded-2xl border border-[var(--border)] bg-[var(--surface-soft)] p-5 text-[var(--text)] transition hover:border-[var(--primary)]/40 hover:bg-[var(--primary)]/10"
      >
        <span class="flex items-center gap-4">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--primary)]/10 text-[var(--primary)]">
            <Phone size={20} />
          </span>

          <span>
            <span class="block text-sm text-[var(--muted)]">{t.information.phoneLabel}</span>
            <span class="font-medium">+506 2437 5750</span>
          </span>
        </span>

        <ArrowRight size={18} className="transition group-hover:translate-x-1" />
      </a>

      <a
        href="https://wa.me/50670717800"
        target="_blank"
        class="group flex items-center justify-between rounded-2xl border border-[var(--border)] bg-[var(--surface-soft)] p-5 text-[var(--text)] transition hover:border-[var(--primary)]/40 hover:bg-[var(--primary)]/10"
      >
        <span class="flex items-center gap-4">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--primary)]/10 text-[var(--primary)]">
            <MessageCircle size={20} />
          </span>

          <span>
            <span class="block text-sm text-[var(--muted)]">{t.information.whatsappLabel}</span>
            <span class="font-medium">+506 7071 7800</span>
          </span>
        </span>

        <ArrowRight size={18} className="transition group-hover:translate-x-1" />
      </a>

      <a
        href="mailto:sales@angular-tech.com"
        class="group flex items-center justify-between rounded-2xl border border-[var(--border)] bg-[var(--surface-soft)] p-5 text-[var(--text)] transition hover:border-[var(--primary)]/40 hover:bg-[var(--primary)]/10"
      >
        <span class="flex items-center gap-4">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--primary)]/10 text-[var(--primary)]">
            <Mail size={20} />
          </span>

          <span>
            <span class="block text-sm text-[var(--muted)]">{t.information.emailLabel}</span>
            <span class="font-medium">sales@angular-tech.com</span>
          </span>
        </span>

        <ArrowRight size={18} className="transition group-hover:translate-x-1" />
      </a>

      <a
        href={`/${lang}/contact`}
        class="mt-4 inline-flex w-fit items-center gap-3 rounded-full bg-[var(--primary)] px-5 py-4 text-sm font-semibold text-white shadow-[0_10px_30px_rgba(0,0,0,0.25),0_0_40px_rgba(18,181,234,0.12)] transition hover:-translate-y-1 hover:bg-[#1b75bb] md:px-8"
      >
        {t.information.freeEvaluation}
        <ArrowRight size={16} />
      </a>

    </div>
  </div>
</section>