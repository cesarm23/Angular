---
import MainLayout from "../../Layout/MainLayout.astro";
import { ArrowLeft, Code2, Wrench } from "lucide-react";
import { services } from "../../data/services";
import { translations } from "../../i18n/translation";

export const prerender = false;

type Lang = "es" | "en";

const urlLang = Astro.url.searchParams.get("lang");

const lang: Lang = urlLang === "en" ? "en" : "es";

const t = translations[lang];

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const Icon = service.icon ?? Code2;
---

<MainLayout title={`${service.title} | ATS`} t={t} lang={lang}>
  <section class="relative min-h-screen overflow-hidden bg-[#0b0b0c] px-8 py-36 text-white">
    <div class="absolute right-[-180px] top-[-180px] h-[420px] w-[420px] rounded-full bg-[#12b5ea]/10 blur-3xl"></div>

    <div class="relative mx-auto max-w-5xl">
      <a
        href={`/?lang=${lang}#services`}
        class="mb-10 inline-flex items-center gap-2 text-sm text-white/60 transition hover:text-[#12b5ea]"
      >
        <ArrowLeft size={16} />
        {t.serviceDetail.backToServices}
      </a>

      <div class="mb-12 rounded-[40px] border border-white/10 bg-white/[0.03] p-10 shadow-[0_10px_40px_rgba(0,0,0,0.35),0_0_50px_rgba(18,181,234,0.10)] backdrop-blur-xl">
        <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/10 bg-[#12b5ea]/10 text-[#12b5ea]">
          <Icon size={30} strokeWidth={1.8} />
        </div>

        <span class="mb-5 inline-block rounded-full border border-[#12b5ea]/20 bg-[#12b5ea]/10 px-4 py-2 text-sm text-[#8edfff]">
          {t.serviceDetail.badge}
        </span>

        <h1 class="mb-6 text-4xl md:text-6xl lg:text-7xl font-bold leading-[0.95] tracking-[-0.05em]">
          {service.title}
        </h1>

        <p class="max-w-3xl text-lg leading-8 text-white/60">
          {service.summary}
        </p>
      </div>

      {
        service.content ? (
          <div
            class="rounded-[28px] border border-white/10 bg-white/[0.03] p-6 text-white/60 backdrop-blur-xl md:p-10
            [&_h2]:mb-4 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-white md:[&_h2]:text-3xl
            [&_h3]:mb-3 [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-white md:[&_h3]:text-2xl
            [&_p]:mb-6 [&_p]:text-sm [&_p]:leading-7 [&_p]:text-white/60 md:[&_p]:text-base md:[&_p]:leading-8
            [&_ul]:mb-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5
            [&_li]:text-sm [&_li]:leading-7 [&_li]:text-white/60 md:[&_li]:text-base
            [&_strong]:font-semibold [&_strong]:text-white"
            set:html={service.content}
          />
        ) : (
          <div class="rounded-[32px] border border-white/10 bg-white/[0.03] p-10 text-center backdrop-blur-xl">
            <div class="mx-auto mb-6 flex h-20 w-20 animate-bounce items-center justify-center rounded-full bg-[#12b5ea]/10 text-[#12b5ea]">
              <Wrench size={36} />
            </div>

            <h2 class="mb-4 text-3xl font-semibold">
              {t.serviceDetail.maintenanceTitle}
            </h2>

            <p class="mx-auto max-w-xl text-white/60">
              {t.serviceDetail.maintenanceDescription}
            </p>
          </div>
        )
      }
    </div>
  </section>
</MainLayout>