---
import MainLayout from "../../../Layout/MainLayout.astro";
import { ArrowLeft, Code2, Wrench } from "lucide-react";
import { services } from "../../../data/services.es";
import { translations } from "../../../i18n/translation";

type Lang = "es" | "en";

const lang: Lang = "es";
const t = translations[lang];

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const Icon = service.icon ?? Code2;
---

<MainLayout title={`${service.title} | ATS`} t={t} lang={lang}>
  <section class="relative min-h-screen overflow-hidden bg-[var(--bg)] px-5 py-36 text-[var(--text)] transition-colors duration-500 md:px-8">
    <div class="pointer-events-none absolute right-[-180px] top-[-180px] h-[420px] w-[420px] rounded-full bg-[var(--primary)]/10 blur-3xl"></div>

    <div class="relative mx-auto max-w-5xl">
      <a
        href={`/${lang}/#services`}
        class="mb-10 inline-flex items-center gap-2 text-sm text-[var(--muted)] transition hover:text-[var(--primary)]"
      >
        <ArrowLeft size={16} />
        {t.serviceDetail.backToServices}
      </a>

      <div class="mb-12 rounded-[40px] border border-[var(--border)] bg-[var(--surface)] p-10 shadow-[var(--shadow-soft)] backdrop-blur-xl">
        <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-2xl border border-[var(--border)] bg-[var(--primary)]/10 text-[var(--primary)]">
          <Icon size={30} strokeWidth={1.8} />
        </div>

        <span class="mb-5 inline-block rounded-full border border-[var(--border)] bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--primary)] backdrop-blur-md">
          {t.serviceDetail.badge}
        </span>

        <h1 class="mb-6 text-4xl font-bold leading-[0.95] tracking-[-0.05em] text-[var(--text)] md:text-6xl lg:text-7xl">
          {service.title}
        </h1>

        <p class="max-w-3xl text-lg leading-8 text-[var(--muted)]">
          {service.summary}
        </p>
      </div>

      {
        service.content ? (
          <div
            class="rounded-[28px] border border-[var(--border)] bg-[var(--surface)] p-6 text-[var(--muted)] shadow-[var(--shadow-soft)] backdrop-blur-xl md:p-10
            [&_h2]:mb-4 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-[var(--text)] md:[&_h2]:text-3xl
            [&_h3]:mb-3 [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-[var(--text)] md:[&_h3]:text-2xl
            [&_p]:mb-6 [&_p]:text-sm [&_p]:leading-7 [&_p]:text-[var(--muted)] md:[&_p]:text-base md:[&_p]:leading-8
            [&_ul]:mb-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5
            [&_li]:text-sm [&_li]:leading-7 [&_li]:text-[var(--muted)] md:[&_li]:text-base
            [&_strong]:font-semibold [&_strong]:text-[var(--text)]"
            set:html={service.content}
          />
        ) : (
          <div class="rounded-[32px] border border-[var(--border)] bg-[var(--surface)] p-10 text-center shadow-[var(--shadow-soft)] backdrop-blur-xl">
            <div class="mx-auto mb-6 flex h-20 w-20 animate-bounce items-center justify-center rounded-full bg-[var(--primary)]/10 text-[var(--primary)]">
              <Wrench size={36} />
            </div>

            <h2 class="mb-4 text-3xl font-semibold text-[var(--text)]">
              {t.serviceDetail.maintenanceTitle}
            </h2>

            <p class="mx-auto max-w-xl text-[var(--muted)]">
              {t.serviceDetail.maintenanceDescription}
            </p>
          </div>
        )
      }
    </div>
  </section>
</MainLayout>